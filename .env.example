# Copy to .env and fill in. Without a key the system runs in rule-based mode.
LLM_PROVIDER=deepseek            # deepseek | openai | qwen | moonshot | zhipu | gemini | custom
DEEPSEEK_API_KEY=
# LLM_API_KEY=                   # generic key (takes precedence over provider-specific keys)
# LLM_MODEL=deepseek-reasoner    # override provider default model
# LLM_BASE_URL=                  # required for LLM_PROVIDER=custom (any OpenAI-compatible endpoint)
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2
# LLM_ENABLED=1                  # 0 forces rule-based fallback

# ---- Read-only database mining (optional; feature is off without DB_HOST/DB_USER/DB_NAME) ----
# Use an account that only has SELECT. The code also forces read-only sessions, row caps and time limits.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=readonly_user
# DB_PASSWORD=password
# DB_NAME=dbname
# DB_CHARSET=utf8mb4
# DB_ALLOWED_TABLES=table_a,table_b     # optional whitelist; empty = every table of the schema
# DB_MAX_ROWS=200000                    # rows pulled per mining run
# DB_QUERY_TIMEOUT_S=30
# DB_PROFILE_PATH=config/db_profile.json   # multi-table mining project profile (default: config/db_profile.json)
